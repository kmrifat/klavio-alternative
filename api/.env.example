APP_ENV=development
HTTP_ADDR=:8080
# Local DBngin services. For the Docker ones (make docker-deps) use
#   postgres://mail:mail@localhost:55432/mail?sslmode=disable  and  redis://localhost:56379/0
DATABASE_URL=postgres://postgres@localhost:54321/klavio?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info
# LOG_FORMAT=text                 # json in production by default
ALLOWED_ORIGINS=http://localhost:5173   # web app origin(s): CORS + passkey origin check

# Passkeys
APP_URL=http://localhost:5173          # invite links point here
WEBAUTHN_RP_ID=localhost               # production: your registrable domain, e.g. yourco.com
WEBAUTHN_RP_NAME=Mail Console

# Cloudflare Access (required in production; leave empty locally)
CF_ACCESS_TEAM_DOMAIN=                 # e.g. acme.cloudflareaccess.com
CF_ACCESS_AUD=                         # the Access application's AUD tag

# Amazon SES: "fake" locally (no AWS calls), "aws" in production
SES_MODE=fake
SES_REGION=us-east-1
SES_EVENT_BUS_ARN=                     # arn:aws:events:<region>:<account>:event-bus/default
DNS_RESOLVER=1.1.1.1:53                # used for brand DNS checks

# Unsubscribe links (HMAC). Production: 32+ random characters, e.g. `openssl rand -base64 48`.
# UNSUBSCRIBE_SECRET=
# UNSUBSCRIBE_SECRET_OLD=            # during rotation only
PUBLIC_BASE_URL_OVERRIDE=http://localhost:8080   # dev: public pages on the API instead of go.<brand>

# Health (M6)
# Blocklists (Spamhaus DBL, SURBL, URIBL) refuse lookups that come through big
# public resolvers (8.8.8.8, 1.1.1.1). Point this at your own recursive resolver
# (e.g. unbound in the VPC, host:port); empty = system resolver; off = no checks.
BLOCKLIST_RESOLVER=off
# BLOCKLIST_CHECK_INTERVAL=6h          # at least 1h
# SPAMHAUS_DQS_KEY=                    # free Spamhaus Data Query Service key (works from any resolver)
# Google Postmaster Tools: path to a service-account JSON key. A secret: mount it,
# never commit it. Empty = "not connected".
# POSTMASTER_CREDENTIALS_FILE=/run/secrets/postmaster.json
