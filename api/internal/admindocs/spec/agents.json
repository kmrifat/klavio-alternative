{
  "tag": {
    "name": "Agents",
    "description": "Tokens for AI agents (Claude Code, Codex, OpenCode…) that use the console through MCP at `/mcp`. A token acts as the person who made it, with at most their role and never a passkey confirmation. AI clients that sign in with OAuth (claude.ai and Claude Desktop connectors) get the same kind of token after the person approves here; the OAuth endpoints themselves (`/.well-known/…`, `/oauth/register`, `/oauth/authorize`, `/oauth/token`) live on the API's public address, outside this API, and are on only when `PUBLIC_API_URL` is set."
  },
  "x-todo": [],
  "paths": {
    "/agent-tokens": {
      "get": {
        "operationId": "listAgentTokens",
        "summary": "Your agent tokens",
        "description": "The signed-in person's agent tokens, newest first, with their state. Secrets are never shown again.",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated"
        ],
        "responses": {
          "200": {
            "description": "Your tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tokens"
                  ],
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AgentToken"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "operationId": "createAgentToken",
        "summary": "Create an agent token",
        "description": "Makes a token for your own agent. It lasts 1–90 days. The secret (`kag_…`) is in this answer only; give it to the agent as a bearer token for `/mcp`. Recorded in the audit log (`agent_token.created`). Agents can't create tokens (it needs a passkey confirmation).",
        "x-role": "signed_in",
        "x-step-up": true,
        "x-error-codes": [
          "unauthenticated",
          "step_up_required",
          "agent_not_allowed",
          "bad_json",
          "name_required",
          "name_too_long",
          "invalid_expiry"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "expires_in_days"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 60,
                    "examples": [
                      "Claude Code on my laptop"
                    ]
                  },
                  "expires_in_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The token, and its secret (shown once).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "secret"
                  ],
                  "properties": {
                    "token": {
                      "$ref": "#/components/schemas/AgentToken"
                    },
                    "secret": {
                      "type": "string",
                      "examples": [
                        "kag_k5qw3ra_…"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`bad_json`, `name_required`, `name_too_long` or `invalid_expiry`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "description": "`step_up_required`: confirm with a passkey first. `agent_not_allowed`: an agent tried.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agent-tokens/{id}/revoke": {
      "post": {
        "operationId": "revokeAgentToken",
        "summary": "Revoke an agent token",
        "description": "Stops one of your tokens at once. No passkey needed to switch one off; an agent may revoke its own person's tokens too. Revoking twice is harmless. Recorded in the audit log (`agent_token.revoked`).",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "not_found"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "The token, now revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token"
                  ],
                  "properties": {
                    "token": {
                      "$ref": "#/components/schemas/AgentToken"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/oauth/grants/{id}": {
      "get": {
        "operationId": "getOAuthGrant",
        "summary": "An AI client's sign-in request",
        "description": "For the console's \"Connect\" screen: which client asks, where the person will be sent back to, how long the token would last, and whether it's still waiting (10 minutes to decide).",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "not_found"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "The request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthGrant"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/oauth/grants/{id}/approve": {
      "post": {
        "operationId": "approveOAuthGrant",
        "summary": "Let the AI client connect as you",
        "description": "Approves a waiting request with a passkey confirmation (so never by an agent). Issues a one-time code, valid 5 minutes, that the client swaps at `/oauth/token` (with PKCE) for an agent token acting as you for 90 days. Recorded in the audit log (`oauth.approved`, then `agent_token.created` when the code is swapped).",
        "x-role": "signed_in",
        "x-step-up": true,
        "x-error-codes": [
          "unauthenticated",
          "step_up_required",
          "agent_not_allowed",
          "not_found",
          "not_pending"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Where to send the person back to: the client's redirect address, with the code (approve) or `error=access_denied` (deny), `state` and `iss`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "redirect_to"
                  ],
                  "properties": {
                    "redirect_to": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "description": "`step_up_required`: confirm with a passkey first. `agent_not_allowed`: an agent tried.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`not_pending`: already answered, or the 10 minutes ran out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/grants/{id}/deny": {
      "post": {
        "operationId": "denyOAuthGrant",
        "summary": "Turn the AI client away",
        "description": "Declines a waiting request; the client is told `access_denied`.",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "not_found",
          "not_pending"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Where to send the person back to: the client's redirect address, with the code (approve) or `error=access_denied` (deny), `state` and `iss`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "redirect_to"
                  ],
                  "properties": {
                    "redirect_to": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`not_pending`: already answered, or the 10 minutes ran out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentToken": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix",
          "created_at",
          "expires_at",
          "revoked_at",
          "last_used_at",
          "state",
          "oauth_client_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "description": "The token's public start, also shown in the audit log.",
            "examples": [
              "kag_k5qw3ra"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Updated at most once a minute."
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          },
          "oauth_client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The AI client a sign-in (claude.ai, Claude Desktop) made this token for; null for tokens made by hand."
          }
        }
      },
      "OAuthGrant": {
        "type": "object",
        "required": [
          "id",
          "client_name",
          "redirect_host",
          "expires_at",
          "status",
          "token_days"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "client_name": {
            "type": "string",
            "description": "As the client registered itself; not verified.",
            "examples": [
              "Claude"
            ]
          },
          "redirect_host": {
            "type": "string",
            "description": "Where the person goes back to after deciding.",
            "examples": [
              "claude.ai"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired"
            ]
          },
          "token_days": {
            "type": "integer",
            "description": "How long the connection's token lasts.",
            "examples": [
              90
            ]
          }
        }
      }
    }
  }
}
