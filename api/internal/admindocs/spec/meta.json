{
  "tag": { "name": "Meta", "description": "The server, the company, the signed-in member, company alerts, and this reference." },
  "x-todo": [],
  "paths": {
    "/meta": {
      "get": {
        "operationId": "getMeta",
        "summary": "Server version and mode",
        "description": "Read by the app on every page, before anyone signs in.",
        "x-role": "public",
        "x-step-up": false,
        "x-error-codes": [],
        "responses": {
          "200": {
            "description": "The server.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Meta" } } }
          }
        }
      }
    },
    "/company": {
      "get": {
        "operationId": "getCompany",
        "summary": "Company name and installation",
        "description": "Settings → General: the company's name and how this server is set up (read from its environment; not editable here).",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated"],
        "responses": {
          "200": {
            "description": "The company.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Company" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      },
      "put": {
        "operationId": "renameCompany",
        "summary": "Rename the company",
        "description": "Sets the name shown in the sidebar and on the sign-in page. Spaces are tidied; at most 80 characters. Owners only. Recorded in the audit log (`company.renamed`, with the old and new name).",
        "x-role": "company:owner",
        "x-step-up": true,
        "x-error-codes": ["unauthenticated", "step_up_required", "forbidden", "bad_json", "name_required", "name_too_long"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 80, "examples": ["Acme Group"] } } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The company after the change.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Company" } } }
          },
          "400": {
            "description": "`bad_json`, `name_required` or `name_too_long`.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/ForbiddenOrStepUp" }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in member",
        "description": "Who is signed in, their roles, and until when their last passkey confirmation (step-up) counts.",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated"],
        "responses": {
          "200": {
            "description": "The member.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "listAlerts",
        "summary": "Company alerts",
        "description": "Unusual activity the app noticed (anomalies, frozen accounts), newest first, at most 100.",
        "x-role": "company:approver",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated", "forbidden"],
        "parameters": [
          { "name": "open", "in": "query", "description": "`true`: only alerts nobody has acknowledged yet.", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "The alerts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["alerts"],
                  "properties": { "alerts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/Alert" } } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/alerts/{id}/acknowledge": {
      "post": {
        "operationId": "acknowledgeAlert",
        "summary": "Acknowledge an alert",
        "description": "Marks it handled by the caller. Recorded in the audit log (`alert.acknowledged`).",
        "x-role": "company:approver",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated", "forbidden", "not_found"],
        "parameters": [{ "$ref": "#/components/parameters/ID" }],
        "responses": {
          "204": { "description": "Acknowledged." },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/docs": {
      "get": {
        "operationId": "getAdminDocs",
        "summary": "This reference",
        "description": "An HTML page that renders `/openapi.json`. Only served when `DEBUG` is on (404 otherwise).",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated"],
        "responses": {
          "200": { "description": "The page.", "content": { "text/html": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getAdminOpenAPI",
        "summary": "This document",
        "description": "The admin API as OpenAPI 3.1. Only served when `DEBUG` is on (404 otherwise).",
        "x-role": "signed_in",
        "x-step-up": false,
        "x-error-codes": ["unauthenticated"],
        "responses": {
          "200": { "description": "The document.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["version", "env", "debug", "company_name"],
        "properties": {
          "version": { "type": "string", "examples": ["1.4.0"] },
          "env": { "type": "string", "enum": ["development", "production"] },
          "debug": { "type": "boolean", "description": "Whether debug aids (this reference) are on." },
          "company_name": {
            "type": "string",
            "description": "The company's name as Settings → General sets it, or `WEBAUTHN_RP_NAME` until it's set. Shown in the sidebar and on the sign-in page.",
            "examples": ["Acme Group"]
          }
        }
      },
      "Company": {
        "type": "object",
        "required": ["name", "display_name", "installation"],
        "properties": {
          "name": { "type": "string", "description": "The name set in Settings → General; empty until one is." },
          "display_name": { "type": "string", "description": "What the app shows: `name`, or `WEBAUTHN_RP_NAME` while it's empty." },
          "installation": {
            "type": "object",
            "description": "How this server is set up, from its environment.",
            "required": ["version", "env", "debug", "app_url", "passkey_domain", "cloudflare_access"],
            "properties": {
              "version": { "type": "string" },
              "env": { "type": "string", "enum": ["development", "production"] },
              "debug": { "type": "boolean" },
              "app_url": { "type": "string", "description": "`APP_URL`: where the web app lives (used in invite links).", "examples": ["https://mail.acme.com"] },
              "passkey_domain": { "type": "string", "description": "`WEBAUTHN_RP_ID`: passkeys only work on this domain and its subdomains.", "examples": ["acme.com"] },
              "cloudflare_access": { "type": "boolean", "description": "Every admin request also needs a Cloudflare Access login." }
            }
          }
        }
      },
      "Me": {
        "type": "object",
        "required": ["user", "brand_roles", "stepped_up_until"],
        "properties": {
          "user": {
            "type": "object",
            "required": ["id", "email", "name", "company_role"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string", "format": "email" },
              "name": { "type": "string" },
              "company_role": { "$ref": "#/components/schemas/CompanyRole" }
            }
          },
          "brand_roles": { "$ref": "#/components/schemas/BrandRoles" },
          "stepped_up_until": { "type": ["string", "null"], "format": "date-time", "description": "Until when the last passkey confirmation counts; null if none." }
        }
      },
      "Alert": {
        "type": "object",
        "required": ["id", "kind", "severity", "user_id", "brand_id", "message", "details", "created_at", "acknowledged_by", "acknowledged_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "type": "string", "description": "What was noticed: `new_device`, `unknown_country`, `import_spike`, `account_brake`, `brand_…` (a brand brake), and others.", "examples": ["new_device"] },
          "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
          "user_id": { "type": ["string", "null"], "format": "uuid" },
          "brand_id": { "type": ["string", "null"], "format": "uuid" },
          "message": { "type": "string" },
          "details": { "description": "Kind-specific facts, as recorded." },
          "created_at": { "type": "string", "format": "date-time" },
          "acknowledged_by": { "type": ["string", "null"], "format": "uuid" },
          "acknowledged_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
