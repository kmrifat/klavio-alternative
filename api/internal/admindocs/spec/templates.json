{
  "tag": {
    "name": "Templates",
    "description": "Templates, the brand layout and the link allowlist."
  },
  "x-todo": [],
  "paths": {
    "/brands/{slug}/layout": {
      "get": {
        "operationId": "getBrandLayout",
        "summary": "The brand layout",
        "description": "The layout that wraps every email the brand sends, with a preview (compiled with sample content and sample merge-tag values) and its check results. Until a brand admin saves one, this is the default layout (`version` 0, `is_default` true). Compiled layouts are cached, so this rarely compiles. Approvers count as viewers.",
        "x-role": "brand:viewer",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "not_found",
          "compiler_busy",
          "compile_timeout"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "responses": {
          "200": {
            "description": "The layout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesLayoutResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/TemplatesCompileUnavailable"
          }
        }
      },
      "put": {
        "operationId": "putBrandLayout",
        "summary": "Change the brand layout",
        "description": "The layout is checked first, compiled with sample content: any issue of severity `error` refuses it with 422 `layout_has_errors` and the issues. `version` must be the version being edited (0 while the default is in use), or the answer is 409 `stale`.\n\nBecause the layout wraps every email the brand sends, a second admin must approve the change. If someone else can (an owner, an approver, or another admin of this brand, not frozen), it is filed as a `layout_change` approval that expires after 7 days, and the answer is 202; when approved it is checked again and applied. If nobody else can approve and the company has never had two admins, the change applies at once (200) and its audit entry records `no_second_admin`; otherwise 409 `no_approver`.\n\nApplying a change saves a new version, starts a new template generation and queues a background rebuild of every live template. Recorded in the audit log: `approval.requested` (202), `layout.updated` (200, or when the approval is carried out).",
        "x-role": "brand:brand_admin",
        "x-step-up": true,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "step_up_required",
          "not_found",
          "bad_json",
          "stale",
          "no_approver",
          "compiler_busy",
          "compile_timeout",
          "layout_has_errors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplatesLayoutInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied without a second admin (the company has never had two). The saved layout, with `templates_queued`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesLayoutResponse"
                }
              }
            }
          },
          "202": {
            "description": "Filed for a second admin's approval; nothing changed yet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "approval"
                  ],
                  "properties": {
                    "approval": {
                      "$ref": "#/components/schemas/TemplatesApproval"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadJSON"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrStepUp"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`stale`: someone saved a newer version since `version`; reload. `no_approver`: a second admin must approve, and nobody else can right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`layout_has_errors`: the layout fails a check. The body carries the issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesRejected"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/TemplatesCompileUnavailable"
          }
        }
      }
    },
    "/brands/{slug}/layout/preview": {
      "post": {
        "operationId": "previewBrandLayout",
        "summary": "Preview a layout",
        "description": "Compiles and checks a layout without saving it, for the layout editor. The answer has the same shape as reading the layout; `version` only sets `is_default` (true when 0).",
        "x-role": "brand:brand_admin",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "not_found",
          "bad_json",
          "compiler_busy",
          "compile_timeout"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplatesLayoutInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The preview and its issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesLayoutResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadJSON"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/TemplatesCompileUnavailable"
          }
        }
      }
    },
    "/brands/{slug}/link-allowlist": {
      "get": {
        "operationId": "getLinkAllowlist",
        "summary": "The link allowlist",
        "description": "Domains, besides the brand's own sending and link domains, that the brand's emails may link to. Approvers count as viewers.",
        "x-role": "brand:viewer",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "not_found"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "responses": {
          "200": {
            "description": "The allowlist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesAllowlist"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "allowLinkDomain",
        "summary": "Allow a link domain",
        "description": "Adds a domain. It is trimmed, lowercased, and loses a trailing dot and a leading `https://` or `http://`. Refused with 400: not a domain name (`invalid_domain`), a link shortener (`shortener`), or a public suffix such as `co.uk` or `github.io` (`public_suffix`). Starts a new template generation and queues a background rebuild of every live template. Recorded in the audit log (`link_allowlist.added`).",
        "x-role": "brand:brand_admin",
        "x-step-up": true,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "step_up_required",
          "not_found",
          "bad_json",
          "already_allowed",
          "invalid_domain",
          "shortener",
          "public_suffix"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "examples": [
                      "shop.example.com"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added. The whole allowlist, with `templates_queued`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesAllowlist"
                }
              }
            }
          },
          "400": {
            "description": "`bad_json`: the body isn't valid JSON for this call, or has unknown fields. `invalid_domain`, `shortener`, `public_suffix`: the domain can't be allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrStepUp"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`already_allowed`: the domain is already on the allowlist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/brands/{slug}/link-allowlist/{domain}": {
      "delete": {
        "operationId": "disallowLinkDomain",
        "summary": "Remove a link domain",
        "description": "Removes a domain (matched lowercased). Starts a new template generation and queues a background rebuild of every live template, whose links to it then fail their checks. Recorded in the audit log (`link_allowlist.removed`).",
        "x-role": "brand:brand_admin",
        "x-step-up": true,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "step_up_required",
          "not_found"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "description": "A domain on the allowlist.",
            "schema": {
              "type": "string",
              "examples": [
                "shop.example.com"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed. The whole allowlist, with `templates_queued`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesAllowlist"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrStepUp"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
