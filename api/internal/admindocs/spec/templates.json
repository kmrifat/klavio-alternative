              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "templates"
                  ],
                  "properties": {
                    "templates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TemplatesTemplateSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "createTemplate",
        "summary": "Create a template",
        "description": "Compiles the template inside the brand layout and checks it, then saves it whatever the checks found: issues of severity `error` block sending, not saving. `name` is trimmed and must be 1–200 characters (400 `invalid_name`); `mjml` must not be blank (400 `invalid_mjml`). `version` is ignored. Recorded in the audit log (`template.created`).",
        "x-role": "brand:editor",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "not_found",
          "bad_json",
          "invalid_name",
          "template_name_taken",
          "layout_changing",
          "compiler_busy",
          "compile_timeout",
          "invalid_mjml"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplatesTemplateInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesTemplateResponse"
                }
              }
            }
          },
          "400": {
            "description": "`bad_json`: the body isn't valid JSON for this call, or has unknown fields. `invalid_name`: the name is empty or too long. `invalid_mjml`: the template is empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`template_name_taken`: another template of this brand has that name. `layout_changing`: the layout or allowlist kept changing while saving; save again in a moment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/TemplatesCompileUnavailable"
          }
        }
      }
    },
    "/brands/{slug}/templates/preview": {
      "post": {
        "operationId": "previewTemplate",
        "summary": "Preview a template",
        "description": "Compiles and checks template MJML inside the brand layout without saving it, for the editor. The previews are filled with sample merge-tag values; they are empty when the template doesn't compile. `name` and `version` are accepted and ignored.",
        "x-role": "brand:editor",
