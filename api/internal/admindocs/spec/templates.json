        "x-role": "brand:editor",
        "x-step-up": false,
        "x-error-codes": [
          "unauthenticated",
          "forbidden",
          "not_found"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          },
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Archived."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "TemplatesCompileUnavailable": {
        "description": "`compiler_busy`: every compile slot stayed taken; try again (sent with `Retry-After: 5`). `compile_timeout`: compiling took too long; make the template smaller.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait, with `compiler_busy`.",
            "schema": {
              "type": "integer",
              "examples": [
                5
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "TemplatesIssue": {
        "type": "object",
        "description": "One problem found while compiling or checking.",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "What was found, e.g. `mjml`, `too_large`, `missing_unsubscribe`, `link_not_allowed`, `unknown_merge_tag`, `template_breaks_layout`, `layout_broken`, `insecure_link`.",
            "examples": [
              "missing_alt"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "description": "Errors block sending (and saving a layout); warnings are advice."
          },
          "message": {
            "type": "string"
          },
          "where": {
            "type": "string",
            "enum": [
              "template",
              "layout"
            ],
            "description": "For MJML errors: which source `line` is in. Absent otherwise."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "For MJML errors: the line in the template or layout. Absent otherwise."
          }
        }
      },
      "TemplatesTag": {
        "type": "object",
        "description": "A merge tag the sender fills per recipient, written `{{name}}` or `{{name | fallback}}`.",
        "required": [
          "name",
          "description",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "first_name"
            ]
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "boolean",
            "description": "A link the app generates; fine as an href."
          }
        }
      },
      "TemplatesLayout": {
        "type": "object",
        "required": [
          "mjml",
          "version",
          "is_default",
          "updated_at"
        ],
        "properties": {
          "mjml": {
            "type": "string",
            "description": "A full MJML document with `{{content}}` exactly once, where templates go."
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "0 while the default layout is in use."
          },
          "is_default": {
            "type": "boolean",
            "description": "True when `version` is 0."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Null for the default layout."
          }
        }
      },
      "TemplatesLayoutInput": {
        "type": "object",
        "required": [
          "mjml",
          "version"
        ],
        "properties": {
          "mjml": {
            "type": "string",
            "description": "At most 32 KB and 80 MJML elements (larger fails the checks with `too_large`)."
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "The version being edited; 0 when editing the default."
          }
        }
      },
      "TemplatesLayoutResponse": {
        "type": "object",
        "required": [
          "layout",
          "preview_html",
          "issues",
          "tags"
        ],
        "properties": {
          "layout": {
            "$ref": "#/components/schemas/TemplatesLayout"
          },
          "preview_html": {
            "type": "string",
            "description": "The layout compiled with sample content and sample merge-tag values; empty if it doesn't compile."
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesIssue"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesTag"
            }
          },
          "templates_queued": {
            "type": "integer",
            "minimum": 0,
            "description": "Only after a save: live templates queued for a background rebuild."
          }
        }
      },
      "TemplatesRejected": {
        "type": "object",
        "description": "An Error that also carries the issues that refused the save.",
        "required": [
          "error",
          "issues"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "layout_has_errors"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesIssue"
            }
          }
        }
      },
      "TemplatesApproval": {
        "type": "object",
        "description": "The approval request filed for the change.",
        "required": [
          "id",
          "status",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "cancelled",
              "expired"
            ],
            "description": "`pending` when just filed."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "7 days after the request."
          }
        }
      },
      "TemplatesAllowedDomain": {
        "type": "object",
        "required": [
          "domain",
          "added_by",
          "created_at"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "examples": [
              "shop.example.com"
            ]
          },
          "added_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TemplatesAllowlist": {
        "type": "object",
        "required": [
          "domains",
          "brand_domains"
        ],
        "properties": {
          "domains": {
            "type": "array",
            "description": "Sorted by domain.",
            "items": {
              "$ref": "#/components/schemas/TemplatesAllowedDomain"
            }
          },
          "brand_domains": {
            "type": "array",
            "description": "The brand's sending domain and link domain, always allowed.",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "templates_queued": {
            "type": "integer",
            "minimum": 0,
            "description": "Only after a change: live templates queued for a background rebuild."
          }
        }
      },
      "TemplatesTemplateInput": {
        "type": "object",
        "required": [
          "name",
          "mjml"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Trimmed; unique among the brand's templates."
          },
          "mjml": {
            "type": "string",
            "description": "The children of `<mj-body>`, placed into the layout at `{{content}}`. At most 64 KB and 150 MJML elements (larger fails the checks with `too_large`)."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "On edit: the version being edited (optimistic concurrency). Ignored on create and preview."
          }
        }
      },
      "TemplatesTemplate": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mjml",
          "html",
          "text",
          "issues",
          "error_count",
          "warning_count",
          "layout_version",
          "stale",
          "version",
          "created_by",
          "updated_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "mjml": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "description": "Compiled inside the layout, merge tags still in place; empty if it didn't compile."
          },
          "text": {
            "type": "string",
            "description": "The plain-text part, merge tags still in place."
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesIssue"
            }
          },
          "error_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Issues of severity `error`; more than 0 means it can't be sent."
          },
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "layout_version": {
            "type": "integer",
            "minimum": 0,
            "description": "The layout version it was built against."
          },
          "stale": {
            "type": "boolean",
            "description": "The layout or allowlist changed and the background rebuild hasn't reached this template yet; its checks may be out of date."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TemplatesTemplateSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "error_count",
          "warning_count",
          "stale",
          "updated_at",
          "updated_by_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "error_count": {
            "type": "integer",
            "minimum": 0
          },
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "boolean",
            "description": "Waiting for the background rebuild after a layout or allowlist change."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TemplatesTemplateResponse": {
        "type": "object",
        "required": [
          "template",
          "preview_html",
          "preview_text",
          "tags"
        ],
        "properties": {
          "template": {
            "$ref": "#/components/schemas/TemplatesTemplate"
          },
          "preview_html": {
            "type": "string",
            "description": "`html` filled with sample merge-tag values."
          },
          "preview_text": {
            "type": "string",
            "description": "`text` filled with sample merge-tag values."
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesTag"
            }
          }
        }
      },
      "TemplatesPreview": {
        "type": "object",
        "required": [
          "preview_html",
          "preview_text",
          "issues"
        ],
        "properties": {
          "preview_html": {
            "type": "string",
            "description": "Empty if the template doesn't compile."
          },
          "preview_text": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplatesIssue"
            }
          }
        }
      }
    }
  }
}
