                "$ref": "#/components/schemas/TemplatesTemplateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The preview and its issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatesPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadJSON"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
